# Backend Environment Variables
PORT=3001
NODE_ENV=production

# Frontend Origin for CORS (comma-separated if multiple)
FRONTEND_URL=https://tpoportal.vercel.app

# Google Sheets Configuration (Legacy 2026/2027 Batches)
SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Database URL for Access Tokens (Neon.tech PostgreSQL)
DATABASE_URL=

# Authentication & Admin
ADMIN_PASSWORD=secure_admin_password
SESSION_SECRET=jwt_session_secret

# Live ERP MySQL Database (gg_app)
# When running inside Docker on the same VM host, use host.docker.internal or 182.19.81.116
GG_DB_HOST=host.docker.internal
GG_DB_PORT=3306
GG_DB_USER=gg_app_user
GG_DB_PASSWORD=mysql_password
GG_DB_NAME=gg_app
