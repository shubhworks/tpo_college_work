generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AccessToken {
  id         String    @id @default(cuid())
  token      String    @unique @db.VarChar(36)
  label      String    @db.VarChar(255)
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@map("access_tokens")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum OtpPurpose {
  ACTIVATE
  RESET
}

// Staff whitelist. A row doubles as the staff account: it is "activated"
// once the owner has verified their email by OTP and set a password.
model WhitelistedEmail {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(255) // always stored lowercase
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  passwordHash String?   @map("password_hash")
  activatedAt  DateTime? @map("activated_at")
  lastLoginAt  DateTime? @map("last_login_at")
  addedBy      String?   @map("added_by") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("whitelisted_emails")
}

model OtpCode {
  id        String     @id @default(cuid())
  email     String     @db.VarChar(255)
  codeHash  String     @map("code_hash")
  purpose   OtpPurpose
  attempts  Int        @default(0)
  expiresAt DateTime   @map("expires_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("otp_codes")
}
